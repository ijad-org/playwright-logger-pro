{
  "name": "playwright-logger-pro-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site of playwright-logger-pro (Docusaurus). Not published; not part of the library package.",
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-changelog": "node scripts/sync-changelog.mjs",
    "check-config": "node scripts/check-config-docs.mjs",
    "check-prism": "node scripts/check-prism-contrast.mjs",
    "start": "npm run sync-changelog && docusaurus start",
    "build": "npm run sync-changelog && npm run check-config && npm run check-prism && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "test": "playwright test -c tests/playwright.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-typedoc": "1.4.3",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.61.1",
    "@types/node": "22.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
