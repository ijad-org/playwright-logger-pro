{
  "name": "playwright-logger-pro",
  "version": "0.2.0",
  "description": "Colorful API and browser-action logging for Playwright: APIRequestContext requests with optional curl output, and a per-test browser timeline with secret redaction",
  "author": "Shahul Hameed M Y (https://linkedin.com/in/shahulhameedmy)",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@11.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijad-org/playwright-logger-pro.git"
  },
  "homepage": "https://ijad-org.github.io/playwright-logger-pro/",
  "bugs": {
    "url": "https://github.com/ijad-org/playwright-logger-pro/issues"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "logger",
    "logging",
    "curl",
    "APIRequestContext",
    "playwright-test",
    "browser",
    "page",
    "locator",
    "e2e"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "fixtures": [
        "./dist/fixtures.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.mjs",
      "require": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs",
    "./dist/fixtures.js",
    "./dist/fixtures.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:meta": "tsx --test e2e/meta/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm build",
    "smoke": "node scripts/smoke-dist.cjs && node scripts/smoke-dist.mjs",
    "check:pkg": "npx --yes publint@0.3.25 --pack npm && npx --yes @arethetypeswrong/cli@0.18.5 --pack . --ignore-rules false-cjs",
    "test:e2e:dist": "PLP_E2E_FROM=dist playwright test -c e2e/playwright.config.ts",
    "perf": "node scripts/perf.mjs",
    "drift": "tsx scripts/check-prototype-drift.ts",
    "contrast": "tsx scripts/curl-contrast.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1"
  }
}
